# App（应用）runtime tier: development | test | staging | production
# Local development may keep placeholders while wiring services.
# staging/production must override every required secret with a real value outside Git.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SQL_ECHO=false

# Reverse proxy（反向代理）site address. Keep local default generic; set a real domain only
# in the deployment secret/config system, not in committed files.
ZHIXING_SITE_ADDRESS=:80
# Public base URL（对外访问地址）for acceptance checks and generated links.
# Deployment should set this to the HTTPS domain through server secrets/config.
ZHIXING_PUBLIC_BASE_URL=http://127.0.0.1:8000
ZHIXING_EVAL_BASE_URL=http://127.0.0.1:8000
# Local backup directory（备份目录）for runbook commands. Real production backups
# should use an encrypted, access-controlled target outside Git.
ZHIXING_BACKUP_DIR=./backups
# Host paths mounted by Docker Compose. On a server, deploy/first-deploy.sh
# injects <deploy-dir>/shared paths so runtime data survives release switches.
ZHIXING_SHARED_DATA_DIR=./data
ZHIXING_SHARED_LOG_DIR=./logs
ZHIXING_SHARED_BACKUP_DIR=./backups

# M1 launch non-secret inputs（受控试运行非密钥输入）
# These values describe launch scope, owners, backup, monitoring and cost limits.
# They are safe variable names for check_m1_launch_inputs.py; do not put real
# secrets, passwords or customer data here.
ZHIXING_M1_AUDIENCE=todo-internal-or-whitelist
ZHIXING_REAL_PAYMENT_ORDER_DISABLED=true
ZHIXING_SERVER_PROVIDER=todo-cloud-or-self-hosted
ZHIXING_SERVER_OS_VERSION=todo-os-version
ZHIXING_SERVER_CPU_RAM_DISK=todo-cpu-ram-disk
ZHIXING_DOMAIN_READY=false
ZHIXING_SERVER_EGRESS_IP_STATUS=unknown
ZHIXING_DEPLOY_MODE=todo-docker-compose-or-managed
ZHIXING_DEPLOY_DIR=todo-absolute-deploy-dir
ZHIXING_DOCKER_STATUS=todo-ready
ZHIXING_SERVER_PORTS_STATUS=todo-80-443-open
ZHIXING_TLS_STATUS=todo-ready
ZHIXING_REVERSE_PROXY_STATUS=todo-ready
ZHIXING_POSTGRES_MODE=todo-compose-or-managed-postgresql
ZHIXING_REDIS_MODE=todo-compose-or-managed-redis
ZHIXING_SECRET_STORE=todo-server-env-ci-secrets-or-cloud-secret-manager
ZHIXING_SECRET_OWNER=todo-owner-role
ZHIXING_SECRET_ROTATION_CADENCE=todo-30-90-days
ZHIXING_LLM_PROVIDER_READY=false
ZHIXING_MAP_API_READY=false
ZHIXING_OPTIONAL_EXTERNAL_APIS=none
ZHIXING_EXTERNAL_API_QUOTA_BUDGET=todo-numeric-provider-budget-and-quota
ZHIXING_PROVIDER_CONSOLE_OWNER=todo-owner-role
ZHIXING_PROVIDER_SUPPORT_CHANNEL=todo-provider-ticket-or-owner-contact
ZHIXING_EXTERNAL_API_DEGRADATION_POLICY=todo-degraded-manual-disabled-policy
ZHIXING_EXTERNAL_API_TIMEOUT_RETRY_POLICY=todo-timeout-and-retry-policy-with-numbers
ZHIXING_TAVILY_SERVICE_STATUS=
ZHIXING_VARIFLIGHT_SERVICE_STATUS=
ZHIXING_AIGOHOTEL_SERVICE_STATUS=
ZHIXING_12306_MCP_STATUS=
ZHIXING_DATA_SCOPE=todo-public-and-desensitized-data-scope
ZHIXING_ACCEPTANCE_WINDOW=todo-acceptance-window
ZHIXING_EVAL_ACCOUNT_READY=false
ZHIXING_BACKUP_TARGET=todo-local-disk-snapshot-or-object-storage
ZHIXING_BACKUP_RETENTION=todo-retention-policy
ZHIXING_RAG_RESTORE_STRATEGY=todo-backup-or-rebuild
ZHIXING_POSTGRES_BACKUP_STATUS=todo-passed-or-blocked
ZHIXING_POSTGRES_RESTORE_DRILL_STATUS=todo-passed-or-blocked
ZHIXING_RAG_RESTORE_DRILL_STATUS=todo-passed-or-blocked
ZHIXING_RESTORE_DRILL_OWNER=todo-owner
ZHIXING_ACCEPTABLE_DATA_LOSS=todo-hours
ZHIXING_MONITORING_PROVIDER=todo-monitoring-provider
ZHIXING_ALERT_CHANNEL=todo-alert-channel
ZHIXING_DAILY_COST_BUDGET=todo-numeric-daily-budget
ZHIXING_HEALTH_ALERT_DELIVERY_STATUS=todo-passed-or-blocked
ZHIXING_READINESS_ALERT_DELIVERY_STATUS=todo-passed-or-blocked
ZHIXING_ALERT_DRILL_OWNER=todo-owner
ZHIXING_ALERT_DRILL_WINDOW=todo-alert-drill-window
ZHIXING_ERROR_RATE_MONITOR_STATUS=todo-passed-or-not-measured
ZHIXING_P95_LATENCY_MONITOR_STATUS=todo-passed-or-not-measured
ZHIXING_TOOL_FAILURE_MONITOR_STATUS=todo-passed-or-not-measured
ZHIXING_COST_ALERT_STATUS=todo-passed-or-not-measured
ZHIXING_BACKUP_ALERT_STATUS=todo-passed-or-not-measured
ZHIXING_LOG_REDACTION_SAMPLE_STATUS=todo-passed-or-not-measured
ZHIXING_ROLLBACK_OWNER=todo-owner-role
ZHIXING_INCIDENT_OWNER=todo-owner-role
ZHIXING_ROLLBACK_DRILL_STATUS=todo-passed-or-blocked
ZHIXING_ROLLBACK_TARGET_STATUS=todo-passed-or-blocked
ZHIXING_POST_ROLLBACK_HEALTH_STATUS=todo-passed-or-blocked
ZHIXING_POST_ROLLBACK_SMOKE_STATUS=todo-passed-or-blocked
ZHIXING_ROLLBACK_DATA_SAFETY_STATUS=todo-passed-or-blocked
ZHIXING_INCIDENT_RESPONSE_STATUS=todo-passed-or-blocked
ZHIXING_INCIDENT_REVIEW_STATUS=todo-passed-or-blocked
ZHIXING_INCIDENT_SEVERITY_POLICY_STATUS=todo-passed-or-blocked
ZHIXING_INCIDENT_COMMUNICATION_STATUS=todo-passed-or-blocked
ZHIXING_LEAK_RESPONSE_OWNER=todo-owner-role
ZHIXING_JWT_SECRET_STATUS=todo-ready-or-rotated
ZHIXING_PROVIDER_KEY_STATUS=todo-ready-or-rotated
ZHIXING_DATABASE_SECRET_STATUS=todo-ready-or-rotated
ZHIXING_REDIS_SECRET_STATUS=todo-ready-or-rotated
ZHIXING_ALLOWED_ORIGINS_STATUS=todo-restricted-domain-origins

# Runtime startup resilience（运行时启动韧性）
RUNTIME_STARTUP_DEPENDENCY_TIMEOUT_SECONDS=12
RUNTIME_MCP_STARTUP_TIMEOUT_SECONDS=25
RUNTIME_MCP_OPTIONAL_STARTUP_TIMEOUT_SECONDS=25

# LLM（大语言模型）provider
# Required for local acceptance-core（核心验收）and staging/production:
# - DASHSCOPE_API_KEY must be a real DashScope key, not your-* / change-me / test-key.
# - Model names normally stay on these defaults and are created through app/utils/llm_factory.py.
DASHSCOPE_API_KEY=your-dashscope-api-key
QWEN_MODEL_NAME=qwen3.6-plus
QWEN_PLANNER_MODEL_NAME=qwen3.6-plus
QWEN_ROUTER_MODEL_NAME=qwen3.6-flash
QWEN_RAG_MODEL_NAME=qwen3.6-flash
QWEN_VISION_MODEL_NAME=qwen3.6-plus
QWEN_REPORT_MODEL_NAME=qwen3.6-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_REQUEST_TIMEOUT_SECONDS=180
QWEN_MAX_RETRIES=1

# LangSmith（LangChain 可观测平台）
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=zhixing-travel-planner-dev
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# PostgreSQL（关系型数据库）
# Required for local bootstrap and staging/production. Host-run scripts use localhost
# with POSTGRES_HOST_PORT; containers use service name postgres from docker-compose.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=travel_planner_db
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=change-me
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_POOL_TIMEOUT_SECONDS=5
POSTGRES_STATEMENT_TIMEOUT_SECONDS=10

# Redis（内存数据结构存储）
# Required for staging/production session locks; development may fall back to local locks.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Session consistency（会话一致性）
SESSION_LOCK_BACKEND=auto
SESSION_LOCK_KEY_PREFIX=zhixing:session_lock
SESSION_LOCK_TTL_SECONDS=300
SESSION_LOCK_RENEW_INTERVAL_SECONDS=30
SESSION_LOCK_ACQUIRE_WAIT_SECONDS=0
SESSION_LOCK_BUSY_RETRY_AFTER_SECONDS=3
SESSION_LOCK_REDIS_OPERATION_TIMEOUT_SECONDS=0.5
SESSION_LOCK_REDIS_FALLBACK_TO_LOCAL=true
SESSION_LOCK_REDIS_RETRY_INTERVAL_SECONDS=5

# API overload protection（接口过载保护）
# Staging/production should use Redis and keep local fallback disabled.
API_RATE_LIMIT_ENABLED=false
API_RATE_LIMIT_BACKEND=redis
API_RATE_LIMIT_REQUESTS_PER_WINDOW=120
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_KEY_PREFIX=zhixing:rate_limit
API_RATE_LIMIT_PROTECTED_PREFIXES=/api/v1
API_RATE_LIMIT_EXEMPT_PATHS=
API_RATE_LIMIT_LOCAL_FALLBACK=false
API_RATE_LIMIT_REDIS_OPERATION_TIMEOUT_SECONDS=0.5

# RAG（检索增强生成）local vector store
# Live acceptance（在线验收）requires both paths to contain readable chroma.sqlite3 metadata
# after scripts/init_rag.py succeeds.
RAG_VECTORSTORE_PATH=data/vectorstore
RAG_COLLECTION_NAME=travel_guides
RAG_INTERNAL_VECTORSTORE_PATH=data/vectorstore_internal
RAG_INTERNAL_COLLECTION_NAME=agency_internal_knowledge

# MCP（模型上下文协议）and external APIs（外部 API，应用程序接口）
# acceptance-core（核心验收）requires real credentials for the APIs used by selected scenarios.
# Staging runtime readiness always requires AMAP_API_KEY; Tavily, VariFlight, and aigohotel
# become hard blockers when the chosen acceptance scenario declares them.
AMAP_API_KEY=your-amap-api-key
# Public browser key for the frontend AMap JavaScript SDK. This is not a
# backend secret, but still keep real deployment values in local/secret envs.
AMAP_WEB_JS_KEY=your-amap-web-js-key
TAVILY_API_KEY=your-tavily-api-key
VARIFLIGHT_API_KEY=your-variflight-api-key
AIGOHOTEL_API_KEY=your-aigohotel-api-key
AIGOHOTEL_MCP_API=
AIGOHOTEL_SECRET_KEY=

# Auth（认证） / JWT（JSON Web Token，令牌认证）
# staging/production must set a long non-default secret through deployment secrets.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_NAME=zhixing_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=600

# CORS（跨域资源共享）
# Multiple origins use comma separation, for example:
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# LangGraph（图式智能体编排框架）
LANGGRAPH_RECURSION_LIMIT=60

# Acceptance evaluation（验收评估）account; use local .env or GitHub Secrets, never commit real passwords.
ZHIXING_EVAL_USERNAME=test
ZHIXING_EVAL_PASSWORD=change-me
