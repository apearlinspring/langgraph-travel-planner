# App（应用）runtime tier: development | test | staging | production
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SQL_ECHO=false

# Runtime startup resilience（运行时启动韧性）
RUNTIME_STARTUP_DEPENDENCY_TIMEOUT_SECONDS=12
RUNTIME_MCP_STARTUP_TIMEOUT_SECONDS=8
RUNTIME_MCP_OPTIONAL_STARTUP_TIMEOUT_SECONDS=25

# LLM（大语言模型）provider; use real values only in local .env or deployment secrets
DASHSCOPE_API_KEY=your-dashscope-api-key
QWEN_MODEL_NAME=qwen3.6-plus
QWEN_PLANNER_MODEL_NAME=qwen3.6-plus
QWEN_ROUTER_MODEL_NAME=qwen3.6-flash
QWEN_RAG_MODEL_NAME=qwen3.6-flash
QWEN_VISION_MODEL_NAME=qwen3.6-plus
QWEN_REPORT_MODEL_NAME=qwen3.6-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_REQUEST_TIMEOUT_SECONDS=180
QWEN_MAX_RETRIES=1

# LangSmith（LangChain 可观测平台）
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=zhixing-travel-planner-dev
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# PostgreSQL（关系型数据库）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=travel_planner_db
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=change-me
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_POOL_TIMEOUT_SECONDS=5
POSTGRES_STATEMENT_TIMEOUT_SECONDS=10

# Redis（内存数据结构存储）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Session consistency（会话一致性）
SESSION_LOCK_BACKEND=auto
SESSION_LOCK_KEY_PREFIX=zhixing:session_lock
SESSION_LOCK_TTL_SECONDS=300
SESSION_LOCK_RENEW_INTERVAL_SECONDS=30
SESSION_LOCK_ACQUIRE_WAIT_SECONDS=0
SESSION_LOCK_BUSY_RETRY_AFTER_SECONDS=3
SESSION_LOCK_REDIS_OPERATION_TIMEOUT_SECONDS=0.5
SESSION_LOCK_REDIS_FALLBACK_TO_LOCAL=true
SESSION_LOCK_REDIS_RETRY_INTERVAL_SECONDS=5

# RAG（检索增强生成）local vector store
# Live acceptance（在线验收）requires this path to contain chroma.sqlite3 after scripts/init_rag.py succeeds.
RAG_VECTORSTORE_PATH=data/vectorstore
RAG_COLLECTION_NAME=travel_guides

# MCP（模型上下文协议）and external APIs（外部 API，应用程序接口）
# acceptance-core（核心验收）requires real credentials for amap, tavily, variflight, and aigohotel-backed scenarios.
AMAP_API_KEY=your-amap-api-key
TAVILY_API_KEY=your-tavily-api-key
VARIFLIGHT_API_KEY=your-variflight-api-key
AIGOHOTEL_API_KEY=your-aigohotel-api-key
AIGOHOTEL_MCP_API=
AIGOHOTEL_SECRET_KEY=

# Auth（认证） / JWT（JSON Web Token，令牌认证）
# production/staging must set a long non-default secret through deployment secrets
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LangGraph（图式智能体编排框架）
LANGGRAPH_RECURSION_LIMIT=60
